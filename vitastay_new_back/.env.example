NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nivas_hostel
DB_USER=nivas_user
DB_PASSWORD=

# MySQL root credentials (required once for: npm run db:setup)
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Vita Stay <noreply@vitastay.com>
# Shown on booking emails when the hostel has no contact_email / contact_phone
SUPPORT_EMAIL=support@vitastay.com
# SUPPORT_PHONE=

# SMS (optional — rent/complaint SMS is skipped until a provider is chosen)
# SMS_PROVIDER=msg91
# SMS_API_KEY=

# App
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
API_URL=http://localhost:5000
UPLOAD_MAX_SIZE=10485760

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SESSION_TIMEOUT_MINUTES=30

# OTP
OTP_EXPIRES_MINUTES=10

# Super Admin bootstrap (used by db:migrate-super-admin)
SUPER_ADMIN_EMAIL=info@vitasystems.ai
SUPER_ADMIN_PASSWORD=Vita@2025

# Isolated hostel/branch databases (CREATE DATABASE uses MySQL root)
# Each hostel/branch gets its own DB: vitastay_<hostel_code_or_name>

# Production / backups (see docs/12-deployment-guide.md)
# NODE_ENV=production
# APP_URL=https://app.example.com
# API_URL=https://app.example.com
# CORS_ORIGINS=https://app.example.com
# MYSQL_BACKUP_USER=  (optional dump account; otherwise MYSQL_ROOT_USER)
# MYSQL_BACKUP_PASSWORD=
# MYSQL_BIN=  (optional, e.g. C:\Program Files\MariaDB 13.0\bin)
# Never run npm run db:seed in staging or production.

# Vita Eye (PKG-010). 32-byte hex. Empty derives from JWT_SECRET in dev/test — set this in production.
# FACE_EMBEDDING_KEY=
# Cosine threshold for known/blocked (0.5–0.99). Default 0.85. Doors are never locked.
# VITA_EYE_MATCH_THRESHOLD=0.85
# Unknown gate stills are deleted after this many days (1–365). Default 30.
# VITA_EYE_UNKNOWN_RETENTION_DAYS=30
# Gold support queue: last capture older than this many hours is stale. Default 24.
# VITA_EYE_STALE_CAPTURE_HOURS=24

# Listing files stay on local /uploads/media until DEC-07 triggers (second API node or public 360 ads).
# Plan: docs/18-object-storage-migration.md. S3 driver is BIC-105. Do not set a fake CDN host.
# Unpublished listing files and /uploads/tenants are not guest-readable. Signed ?exp&sig is the S3 shape.
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com

# Payments (DEC-08: Razorpay hosted checkout). Mock is tests/local only.
# PAYMENT_GATEWAY=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_GATEWAY=mock

# BIC-025 commute (Geocoding + Distance Matrix). Server key only — never put this in Vite.
# GOOGLE_MAPS_SERVER_API_KEY=
# COMMUTE_CACHE_TTL_HOURS=168
# Tests use an internal mock when this key is empty (COMMUTE_PROVIDER=mock also forces it).
